<UserControl x:Class="Elka.VoiceMeeterFxHost.App.EngineStatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{StaticResource TextBrush}">
    <StackPanel>
        <Grid MinHeight="26" ToolTip="{Binding Detail}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StateText" Text="{Binding StateText}" Foreground="{Binding StateColor}"
                       FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock x:Name="SampleRateText" Grid.Column="1" Margin="24,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                <Run Text="Sample Rate  " FontSize="11" Foreground="{StaticResource MutedTextBrush}" /><Run Text="{Binding SampleRateText, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" />
            </TextBlock>
            <TextBlock x:Name="BufferText" Grid.Column="2" Margin="16,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                <Run Text="Buffer  " FontSize="11" Foreground="{StaticResource MutedTextBrush}" /><Run Text="{Binding BufferText, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" />
            </TextBlock>
            <TextBlock x:Name="CycleText" Grid.Column="3" Margin="16,0,0,0" VerticalAlignment="Center"
                       ToolTip="Audio-block time: buffer samples divided by sample rate. This is the processing budget, not end-to-end latency.">
                <Run Text="Cycle  " FontSize="11" Foreground="{StaticResource MutedTextBrush}" /><Run Text="{Binding CycleText, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" />
            </TextBlock>
        </Grid>
        <TextBlock x:Name="ActivityText" Visibility="Collapsed" Margin="0,5,0,0" FontSize="11"
                   Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" />
    </StackPanel>
</UserControl>
