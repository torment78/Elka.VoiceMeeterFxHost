<UserControl x:Class="Elka.VoiceMeeterFxHost.App.RollbackPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource TextBrush}" Margin="18">
  <UserControl.Resources>
    <Style TargetType="ScrollBar" BasedOn="{StaticResource StableVerticalScrollBar}" />
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,12">
      <Button x:Name="BackButton" Width="34" Height="34" Padding="0" ToolTip="Back to Settings"
              AutomationProperties.Name="Back to Settings" Margin="0,0,10,0">
        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72B;" />
      </Button>
      <Button x:Name="RefreshButton" DockPanel.Dock="Right" Width="34" Height="34" Padding="0"
              ToolTip="Refresh versions" AutomationProperties.Name="Refresh versions">
        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;" />
      </Button>
      <TextBlock Text="Rollback" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
    </DockPanel>
    <TextBlock x:Name="InstalledVersion" Grid.Row="1" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,12" />
    <Grid Grid.Row="2" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button x:Name="SignedButton" Content="Signed" MinHeight="34" ToolTip="Signed stable releases" />
      <Button x:Name="DevButton" Grid.Column="2" Content="Dev" MinHeight="34" ToolTip="Development releases; may be unsigned" />
    </Grid>
    <ListBox x:Name="Versions" Grid.Row="3" DisplayMemberPath="Version" SelectionMode="Single"
             AutomationProperties.Name="Older versions" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True"
             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" />
    <TextBlock x:Name="Status" Grid.Row="4" TextWrapping="Wrap" FontSize="12" MinHeight="36"
               Margin="0,10,0,6" Foreground="{DynamicResource MutedBrush}" />
    <TextBlock Grid.Row="5" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{DynamicResource MutedBrush}"
               Text="Older versions may not support newer settings. Your current setup will be backed up before installation. FX Host will close when the installer opens." />
    <Grid Grid.Row="6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button x:Name="InstallButton" Content="Download and Install" MinHeight="34" IsEnabled="False" />
      <Button x:Name="CancelButton" Grid.Column="1" Content="Cancel" MinHeight="34" Margin="8,0,0,0" Visibility="Collapsed" />
    </Grid>
  </Grid>
</UserControl>
