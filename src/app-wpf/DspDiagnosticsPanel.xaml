<UserControl x:Class="Elka.VoiceMeeterFxHost.App.DspDiagnosticsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{StaticResource TextBrush}">
    <UserControl.Resources>
        <SolidColorBrush x:Key="DspAccent" Color="#59CED8" />
        <SolidColorBrush x:Key="DspDanger" Color="#EF7779" />
        <Style x:Key="DspBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="7" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="PART_Track">
                            <Border Background="#303C44" CornerRadius="3" />
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                    HorizontalAlignment="Left" CornerRadius="3" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <Border Style="{StaticResource PanelCard}" BorderBrush="{StaticResource DspAccent}" Margin="0,0,0,16">
            <StackPanel>
                <Button x:Name="PerformanceToggle" Content="DSP Performance" FontSize="18" FontWeight="SemiBold"
                        HorizontalContentAlignment="Left" Foreground="{StaticResource DspAccent}"
                        BorderBrush="{StaticResource DspAccent}" Background="#143439" Click="PerformanceToggle_Click"
                        ToolTip="Expand or collapse DSP performance. Overrun detection continues in the background." />
                <StackPanel x:Name="PerformanceContent" Visibility="Collapsed" Margin="0,12,0,0">
                    <Border BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,12" Margin="0,0,0,12">
                        <StackPanel x:Name="HostUsageContent">
                            <TextBlock Text="Application" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0" Background="Transparent"
                                            ToolTip="FX Host process CPU usage across all logical processors. Includes the UI and in-process VSTs, but not separate plugin-worker processes. This is not a callback budget percentage.">
                                    <TextBlock Text="CPU" FontSize="11" Style="{StaticResource MutedText}" />
                                    <TextBlock Text="{Binding CpuText}" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,12,0" Background="Transparent"
                                            ToolTip="RAM used by the FX Host process: private working set, or working set if Windows cannot supply the private figure. Separate plugin-worker processes are not included.">
                                    <TextBlock Text="RAM" FontSize="11" Style="{StaticResource MutedText}" />
                                    <TextBlock Text="{Binding RamText}" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Background="Transparent"
                                            ToolTip="Highest current callback or ASIO processing peak, in microseconds. Each active stream's peak resets every 10 seconds, so startup spikes do not stay indefinitely. This is elapsed audio-engine processing time, not whole-application CPU time. Overrun history is kept.">
                                    <TextBlock Text="Engine peak" FontSize="11" Style="{StaticResource MutedText}" />
                                    <TextBlock Text="{Binding EnginePeakText}" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <ComboBox x:Name="StreamPicker" HorizontalAlignment="Left" Width="160" Margin="0,0,0,10"
                              SelectedIndex="0" SelectionChanged="StreamPicker_SelectionChanged"
                              ToolTip="Filter callback summaries and individual VSTs. Each callback keeps its own average, peak and budget.">
                        <ComboBoxItem Content="All VSTs" />
                        <ComboBoxItem Content="Input callback" />
                        <ComboBoxItem Content="Output callback" />
                        <ComboBoxItem Content="Main callback" />
                        <ComboBoxItem Content="ASIO Patch" />
                    </ComboBox>
                    <StackPanel x:Name="CycleContent">
                        <ItemsControl x:Name="CallbackRows" Margin="0,0,0,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel DataContext="{Binding Value}" Background="Transparent" Margin="0,0,0,12"
                                                ToolTip="{Binding Detail}" ToolTipService.InitialShowDelay="300" ToolTipService.ShowDuration="60000">
                                        <TextBlock Text="{Binding StreamName}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,7" />
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition Width="0.8*" /></Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,8,0">
                                                <TextBlock Text="Cycle budget" FontSize="11" Style="{StaticResource MutedText}" />
                                                <TextBlock Text="{Binding BudgetText}" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                                <TextBlock Text="Average" FontSize="11" Style="{StaticResource MutedText}" />
                                                <TextBlock Text="{Binding ProcessingText}" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding UsageText}" FontSize="12" Foreground="{Binding UsageColor}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                                <TextBlock Text="Peak" FontSize="11" Style="{StaticResource MutedText}" />
                                                <TextBlock Text="{Binding PeakText}" FontSize="14" FontWeight="SemiBold" Foreground="{Binding PeakColor}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding PeakUsageText}" FontSize="12" Foreground="{Binding PeakColor}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="3">
                                                <TextBlock Text="Overruns" FontSize="11" Style="{StaticResource MutedText}" />
                                                <TextBlock Text="{Binding OverrunsText}" FontSize="14" FontWeight="SemiBold" Foreground="{Binding OverrunsColor}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                        <ProgressBar Style="{StaticResource DspBar}" Value="{Binding BarValue, Mode=OneWay}"
                                                     Foreground="{Binding BarColor}" Margin="0,9,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="6" Padding="8">
                            <StackPanel>
                                <Button x:Name="IndividualToggle" Content="Individual" HorizontalContentAlignment="Left"
                                        FontWeight="SemiBold" Click="IndividualToggle_Click"
                                        ToolTip="Expand or collapse individual VST averages. Hover over a row for peaks and overrun details." />
                                <StackPanel x:Name="IndividualContent" Visibility="Collapsed" Margin="0,10,0,0">
                                    <ComboBox x:Name="SortPicker" HorizontalAlignment="Left" Width="204" Margin="0,0,0,10"
                                              SelectedIndex="0" SelectionChanged="SortPicker_SelectionChanged"
                                              ToolTip="ID order keeps VST rows in a fixed order. Highest average usage ranks by callback budget percentage.">
                                        <ComboBoxItem Content="ID order" />
                                        <ComboBoxItem Content="Highest average usage" />
                                    </ComboBox>
                                    <TextBlock x:Name="PerformanceEmpty" Text="{Binding EmptyText}" Style="{StaticResource MutedText}" Margin="0,2,0,12" />
                                    <ScrollViewer x:Name="PluginScroller" MaxHeight="320" VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                                        <ScrollViewer.Resources>
                                            <Style TargetType="ScrollBar" BasedOn="{StaticResource StableVerticalScrollBar}" />
                                        </ScrollViewer.Resources>
                                        <ItemsControl x:Name="PluginRows">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border DataContext="{Binding Value}" Height="64" Padding="0,0,8,10" Background="Transparent"
                                                            ToolTip="{Binding Detail}" ToolTipService.InitialShowDelay="300" ToolTipService.ShowDuration="60000">
                                                        <StackPanel>
                                                            <Grid Margin="0,0,0,4">
                                                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                                <TextBlock TextTrimming="CharacterEllipsis" Margin="0,0,8,0">
                                                                    <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  /  " Foreground="{StaticResource MutedTextBrush}" /><Run Text="{Binding StreamName, Mode=OneWay}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                                                </TextBlock>
                                                                <TextBlock Grid.Column="1" Text="{Binding IdText}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" VerticalAlignment="Center" />
                                                            </Grid>
                                                            <TextBlock FontSize="12" Margin="0,0,0,5">
                                                                <Run Text="Average  " Foreground="{StaticResource MutedTextBrush}" /><Run Text="{Binding AverageText, Mode=OneWay}" />
                                                            </TextBlock>
                                                            <ProgressBar Style="{StaticResource DspBar}" Value="{Binding BarValue, Mode=OneWay}" Foreground="{Binding BarColor}" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>
        <Border Style="{StaticResource PanelCard}" BorderBrush="{StaticResource DspDanger}" Margin="0,0,0,16">
            <StackPanel>
                <Button x:Name="OverrunToggle" Content="DSP Overrun Log" FontSize="18" FontWeight="SemiBold"
                        HorizontalContentAlignment="Left" Foreground="{StaticResource DspDanger}"
                        BorderBrush="{StaticResource DspDanger}" Background="#382326" Click="OverrunToggle_Click"
                        ToolTip="Expand or collapse the log. Detection stays active when collapsed or in the tray." />
                <StackPanel x:Name="OverrunContent" Visibility="Collapsed" Margin="0,10,0,0">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock x:Name="OverrunCount" Text="No budget overruns recorded." VerticalAlignment="Center" Style="{StaticResource MutedText}" />
                        <Button Grid.Column="1" Width="32" MinHeight="28" Padding="4" FontFamily="Segoe MDL2 Assets" Content="&#xE894;"
                                ToolTip="Clear the displayed overrun log. The saved log file is kept." Click="ClearLog_Click" />
                    </Grid>
                    <ScrollViewer x:Name="OverrunScroller" MaxHeight="300" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                        <ScrollViewer.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource StableVerticalScrollBar}" />
                        </ScrollViewer.Resources>
                        <ItemsControl x:Name="OverrunRows">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,0,1" Padding="0,10,8,12" Margin="0,0,0,6">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Heading}" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBlock Text="{Binding Label}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,7,0,10" />
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Cycle budget" FontSize="12" Style="{StaticResource MutedText}" />
                                                    <TextBlock Text="{Binding BudgetText}" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="Processing" FontSize="12" Style="{StaticResource MutedText}" />
                                                    <TextBlock Text="{Binding ProcessingText}" Foreground="{StaticResource DspDanger}" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Usage" FontSize="12" Style="{StaticResource MutedText}" />
                                                    <TextBlock Text="{Binding UsageText}" Foreground="{StaticResource DspDanger}" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0" />
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="{Binding ExcessText}" Foreground="{StaticResource DspDanger}" Margin="0,10,0,5" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding ContextText}" FontSize="11" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
                <TextBlock x:Name="HealthText" Visibility="Collapsed" Foreground="{StaticResource DspDanger}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
